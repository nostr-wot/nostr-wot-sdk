{
  "name": "@nostr-wot/pq",
  "version": "0.2.0",
  "description": "Post-quantum identity keys for Nostr: derive ML-KEM-1024 and ML-DSA-87 keys from a NIP-06 seed, and build, parse and verify the kind:10203 attestation.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/pq"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/pq",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.5.0",
    "@noble/post-quantum": "^0.6.1"
  },
  "peerDependencies": {
    "nostr-tools": ">=2.0.0"
  },
  "devDependencies": {
    "@scure/bip32": "^1.5.0",
    "@scure/bip39": "^1.4.0",
    "nostr-tools": "^2.24.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "sideEffects": false,
  "keywords": [
    "nostr",
    "post-quantum",
    "pqc",
    "ml-kem",
    "ml-dsa",
    "fips-203",
    "fips-204",
    "nip-06",
    "harvest-now-decrypt-later"
  ]
}
