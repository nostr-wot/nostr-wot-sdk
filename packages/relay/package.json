{
  "name": "@nostr-wot/relay",
  "version": "1.0.2-next.0",
  "description": "Deprecated compatibility wrapper for nostr-wot-sdk/relay.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/relay"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/relay",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./hub": {
      "import": {
        "types": "./dist/hub/index.d.ts",
        "default": "./dist/hub/index.js"
      },
      "require": {
        "types": "./dist/hub/index.d.cts",
        "default": "./dist/hub/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/dist-stamp.mjs stamp",
    "typecheck": "tsc --noEmit",
    "check:dist": "node ../../scripts/dist-stamp.mjs check"
  },
  "sideEffects": false,
  "keywords": [
    "nostr",
    "relay",
    "websocket",
    "pool",
    "batcher",
    "nostr-tools",
    "low-level"
  ],
  "deprecated": "Use nostr-wot-sdk/relay instead. The implementation moved to nostr-wot-sdk; this package only forwards the existing API. See https://github.com/nostr-wot/nostr-wot-sdk/blob/main/docs/package-migration.md",
  "dependencies": {
    "nostr-wot-sdk": "^3.0.1-next.0"
  }
}
