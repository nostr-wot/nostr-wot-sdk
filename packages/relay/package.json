{
  "name": "@nostr-wot/relay",
  "version": "0.1.1",
  "description": "Standalone Nostr relay utilities: pool management, query batching, stats, low-level helpers.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/relay"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/relay",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./hub": {
      "import": {
        "types": "./dist/hub/index.d.ts",
        "default": "./dist/hub/index.js"
      },
      "require": {
        "types": "./dist/hub/index.d.cts",
        "default": "./dist/hub/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/dist-stamp.mjs stamp",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check:dist": "node ../../scripts/dist-stamp.mjs check"
  },
  "peerDependencies": {
    "nostr-tools": ">=2.0.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "keywords": [
    "nostr",
    "relay",
    "websocket",
    "pool",
    "batcher",
    "nostr-tools",
    "low-level"
  ],
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
