{
  "name": "@nostr-wot/auth",
  "version": "0.2.0",
  "description": "Nostr authentication for HTTP servers — challenge / signed-event verify (NIP-98) / JWT. Framework-agnostic Web-standard handlers + Next.js App Router shim + client helper.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "MIT",
  "keywords": [
    "nostr",
    "auth",
    "authentication",
    "jwt",
    "nip-98",
    "challenge",
    "signature",
    "next.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/auth"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/auth",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next/index.d.ts",
        "default": "./dist/next/index.js"
      },
      "require": {
        "types": "./dist/next/index.d.cts",
        "default": "./dist/next/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "peerDependencies": {
    "nostr-tools": ">=2.0.0",
    "@nostr-wot/signers": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@nostr-wot/signers": {
      "optional": true
    }
  },
  "sideEffects": false
}
