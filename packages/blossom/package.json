{
  "name": "@nostr-wot/blossom",
  "version": "1.0.2-next.0",
  "description": "Deprecated compatibility wrapper for nostr-wot-sdk/blossom.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "GPL-3.0-only",
  "keywords": [
    "nostr",
    "blossom",
    "bud-01",
    "upload",
    "media",
    "content-addressed"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/blossom"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/blossom",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/dist-stamp.mjs stamp",
    "typecheck": "tsc --noEmit",
    "check:dist": "node ../../scripts/dist-stamp.mjs check"
  },
  "dependencies": {
    "nostr-wot-sdk": "^3.0.1-next.0"
  },
  "sideEffects": false,
  "deprecated": "Use nostr-wot-sdk/blossom instead. The implementation moved to nostr-wot-sdk; this package only forwards the existing API. See https://github.com/nostr-wot/nostr-wot-sdk/blob/main/docs/package-migration.md"
}
