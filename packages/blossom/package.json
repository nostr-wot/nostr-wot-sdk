{
  "name": "@nostr-wot/blossom",
  "version": "0.1.4",
  "description": "Blossom file upload / mirror / delete helpers for Nostr. Content-addressed (sha256), kind-24242 BUD-01 auth, configurable server failover.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "MIT",
  "keywords": [
    "nostr",
    "blossom",
    "bud-01",
    "upload",
    "media",
    "content-addressed"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/blossom"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/blossom",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@nostr-wot/signers": "0.4.0"
  },
  "sideEffects": false
}
