{
  "name": "@nostr-wot/data",
  "version": "1.0.1",
  "description": "Deprecated compatibility wrapper for nostr-wot-sdk/data.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/data"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/data",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cache": {
      "import": {
        "types": "./dist/cache/index.d.ts",
        "default": "./dist/cache/index.js"
      },
      "require": {
        "types": "./dist/cache/index.d.cts",
        "default": "./dist/cache/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/dist-stamp.mjs stamp",
    "typecheck": "tsc --noEmit",
    "check:dist": "node ../../scripts/dist-stamp.mjs check"
  },
  "sideEffects": false,
  "keywords": [
    "nostr",
    "profile",
    "notes",
    "thread",
    "follows",
    "reactions",
    "zaps",
    "react-hooks",
    "swr",
    "nip-65",
    "outbox",
    "web-of-trust"
  ],
  "dependencies": {
    "nostr-wot-sdk": "^3.0.0"
  },
  "deprecated": "Use nostr-wot-sdk/data instead. The implementation moved to nostr-wot-sdk; this package only forwards the existing API. See https://github.com/nostr-wot/nostr-wot-sdk/blob/main/docs/package-migration.md"
}
