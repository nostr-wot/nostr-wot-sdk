{
  "name": "@nostr-wot/data",
  "version": "0.0.0",
  "description": "Pure-function Nostr data layer: profiles, notes, threads, engagement, NIP-65 outbox. Optional SWR cache + React hooks.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/data"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/data",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./cache": {
      "import": { "types": "./dist/cache/index.d.ts", "default": "./dist/cache/index.js" },
      "require": { "types": "./dist/cache/index.d.cts", "default": "./dist/cache/index.cjs" }
    },
    "./react": {
      "import": { "types": "./dist/react/index.d.ts", "default": "./dist/react/index.js" },
      "require": { "types": "./dist/react/index.d.cts", "default": "./dist/react/index.cjs" }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "nostr-tools": ">=2.0.0",
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "sideEffects": false
}
