  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/dist-stamp.mjs stamp",
    "typecheck": "tsc --noEmit",
    "check:dist": "node ../../scripts/dist-stamp.mjs check",
    "test": "vitest run",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@nostr-wot/wot": "^3.0.1-next.0",
    "@noble/hashes": "^1.5.0",
    "@nostr-wot/pq": "^1.0.0"
  },
