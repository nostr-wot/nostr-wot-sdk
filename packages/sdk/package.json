{
  "name": "nostr-wot-sdk",
  "version": "1.0.1",
  "description": "Meta-package re-exporting the @nostr-wot/* family (wot, relay, data, signers, ui, dm, wallet, auth, blossom) under subpaths. Existing imports keep working; new code should depend on the scoped packages directly.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "MIT",
  "keywords": [
    "nostr",
    "web-of-trust",
    "wot",
    "sdk",
    "react-hooks",
    "social-graph",
    "trust",
    "decentralized",
    "data",
    "outbox",
    "nip-65"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./relay": {
      "import": {
        "types": "./dist/relay/index.d.ts",
        "default": "./dist/relay/index.js"
      },
      "require": {
        "types": "./dist/relay/index.d.cts",
        "default": "./dist/relay/index.cjs"
      }
    },
    "./relay/react": {
      "import": {
        "types": "./dist/relay/react/index.d.ts",
        "default": "./dist/relay/react/index.js"
      },
      "require": {
        "types": "./dist/relay/react/index.d.cts",
        "default": "./dist/relay/react/index.cjs"
      }
    },
    "./data": {
      "import": {
        "types": "./dist/data/index.d.ts",
        "default": "./dist/data/index.js"
      },
      "require": {
        "types": "./dist/data/index.d.cts",
        "default": "./dist/data/index.cjs"
      }
    },
    "./data/cache": {
      "import": {
        "types": "./dist/data/cache/index.d.ts",
        "default": "./dist/data/cache/index.js"
      },
      "require": {
        "types": "./dist/data/cache/index.d.cts",
        "default": "./dist/data/cache/index.cjs"
      }
    },
    "./signers": {
      "import": {
        "types": "./dist/signers/index.d.ts",
        "default": "./dist/signers/index.js"
      },
      "require": {
        "types": "./dist/signers/index.d.cts",
        "default": "./dist/signers/index.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui/index.d.ts",
        "default": "./dist/ui/index.js"
      },
      "require": {
        "types": "./dist/ui/index.d.cts",
        "default": "./dist/ui/index.cjs"
      }
    },
    "./dm": {
      "import": {
        "types": "./dist/dm/index.d.ts",
        "default": "./dist/dm/index.js"
      },
      "require": {
        "types": "./dist/dm/index.d.cts",
        "default": "./dist/dm/index.cjs"
      }
    },
    "./dm/react": {
      "import": {
        "types": "./dist/dm/react/index.d.ts",
        "default": "./dist/dm/react/index.js"
      },
      "require": {
        "types": "./dist/dm/react/index.d.cts",
        "default": "./dist/dm/react/index.cjs"
      }
    },
    "./wallet": {
      "import": {
        "types": "./dist/wallet/index.d.ts",
        "default": "./dist/wallet/index.js"
      },
      "require": {
        "types": "./dist/wallet/index.d.cts",
        "default": "./dist/wallet/index.cjs"
      }
    },
    "./wallet/react": {
      "import": {
        "types": "./dist/wallet/react/index.d.ts",
        "default": "./dist/wallet/react/index.js"
      },
      "require": {
        "types": "./dist/wallet/react/index.d.cts",
        "default": "./dist/wallet/react/index.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth/index.d.ts",
        "default": "./dist/auth/index.js"
      },
      "require": {
        "types": "./dist/auth/index.d.cts",
        "default": "./dist/auth/index.cjs"
      }
    },
    "./blossom": {
      "import": {
        "types": "./dist/blossom/index.d.ts",
        "default": "./dist/blossom/index.js"
      },
      "require": {
        "types": "./dist/blossom/index.d.cts",
        "default": "./dist/blossom/index.cjs"
      }
    },
    "./graph": {
      "import": {
        "types": "./dist/graph/index.d.ts",
        "default": "./dist/graph/index.js"
      },
      "require": {
        "types": "./dist/graph/index.d.cts",
        "default": "./dist/graph/index.cjs"
      }
    },
    "./graph/react": {
      "import": {
        "types": "./dist/graph/react/index.d.ts",
        "default": "./dist/graph/react/index.js"
      },
      "require": {
        "types": "./dist/graph/react/index.d.cts",
        "default": "./dist/graph/react/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nostr-wot/auth": "^3.0.0",
    "@nostr-wot/blossom": "^0.1.7",
    "@nostr-wot/data": "^0.5.0",
    "@nostr-wot/graph": "^0.2.0",
    "@nostr-wot/dm": "^0.6.0",
    "@nostr-wot/relay": "^0.1.1",
    "@nostr-wot/signers": "^1.2.0",
    "@nostr-wot/ui": "^0.7.1",
    "@nostr-wot/wallet": "^0.3.4",
    "@nostr-wot/wot": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false
}
