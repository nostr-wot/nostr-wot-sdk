{
  "name": "nostr-wot-sdk",
  "version": "3.0.1-next.0",
  "description": "Nostr application tools: relays, profiles, notes, signer clients, file uploads and storage, with explicit subpath imports.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "GPL-3.0-only",
  "keywords": [
    "nostr",
    "web-of-trust",
    "wot",
    "sdk",
    "react-hooks",
    "social-graph",
    "trust",
    "decentralized",
    "data",
    "outbox",
    "nip-65"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
