{
  "name": "nostr-wot-sdk",
  "version": "0.8.4",
  "description": "Meta-package re-exporting @nostr-wot/{wot,relay,data}. Existing imports keep working; new code should depend on the scoped packages directly.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "MIT",
  "keywords": [
    "nostr",
    "web-of-trust",
    "wot",
    "sdk",
    "react-hooks",
    "social-graph",
    "trust",
    "decentralized",
    "data",
    "outbox",
    "nip-65"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./solid": {
      "import": {
        "types": "./dist/solid/index.d.ts",
        "default": "./dist/solid/index.js"
      },
      "require": {
        "types": "./dist/solid/index.d.cts",
        "default": "./dist/solid/index.cjs"
      }
    },
    "./relay": {
      "import": {
        "types": "./dist/relay/index.d.ts",
        "default": "./dist/relay/index.js"
      },
      "require": {
        "types": "./dist/relay/index.d.cts",
        "default": "./dist/relay/index.cjs"
      }
    },
    "./relay/react": {
      "import": {
        "types": "./dist/relay/react/index.d.ts",
        "default": "./dist/relay/react/index.js"
      },
      "require": {
        "types": "./dist/relay/react/index.d.cts",
        "default": "./dist/relay/react/index.cjs"
      }
    },
    "./data": {
      "import": {
        "types": "./dist/data/index.d.ts",
        "default": "./dist/data/index.js"
      },
      "require": {
        "types": "./dist/data/index.d.cts",
        "default": "./dist/data/index.cjs"
      }
    },
    "./data/cache": {
      "import": {
        "types": "./dist/data/cache/index.d.ts",
        "default": "./dist/data/cache/index.js"
      },
      "require": {
        "types": "./dist/data/cache/index.d.cts",
        "default": "./dist/data/cache/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@nostr-wot/data": "^0.3.0",
    "@nostr-wot/relay": "^0.1.0",
    "@nostr-wot/wot": "^0.1.3"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "solid-js": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "sideEffects": false
}
