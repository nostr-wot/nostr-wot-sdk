{
  "name": "@nostr-wot/bunker",
  "version": "1.0.2",
  "description": "Deprecated compatibility wrapper for @nostr-wot/identity/bunker.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "GPL-3.0-only",
  "keywords": [
    "nostr",
    "nip-46",
    "bunker",
    "nostr-connect",
    "remote-signer",
    "signer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/bunker"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/bunker",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/dist-stamp.mjs stamp",
    "typecheck": "tsc --noEmit",
    "check:dist": "node ../../scripts/dist-stamp.mjs check"
  },
  "dependencies": {
    "@nostr-wot/identity": "^1.1.0"
  },
  "sideEffects": false,
  "deprecated": "Use @nostr-wot/identity/bunker instead. The implementation moved to @nostr-wot/identity; this package only forwards the existing API. See https://github.com/nostr-wot/nostr-wot-sdk/blob/main/docs/package-migration.md"
}
