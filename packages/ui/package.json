{
  "name": "@nostr-wot/ui",
  "version": "0.5.1",
  "description": "Headless React UI for Nostr — login modal/widget, session provider, themable via CSS variables.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "MIT",
  "keywords": [
    "nostr",
    "react",
    "login",
    "ui",
    "modal",
    "widget",
    "nip-07",
    "nip-46",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/ui",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@nostr-wot/data": "^0.4.0",
    "@nostr-wot/signers": "^0.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6"
  },
  "peerDependencies": {
    "nostr-tools": ">=2.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "sideEffects": [
    "*.css"
  ]
}
