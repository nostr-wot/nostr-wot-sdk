{
  "name": "@nostr-wot/vault",
  "version": "0.1.0",
  "description": "Platform-neutral vault cryptography for the @nostr-wot packages: PBKDF2-HMAC-SHA-256 key derivation and AES-256-GCM, byte compatible with the WebCrypto vault format, with no WebCrypto required.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "MIT",
  "keywords": [
    "nostr",
    "vault",
    "pbkdf2",
    "aes-gcm",
    "platform-neutral"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/vault"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/vault",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.4.0",
    "@nostr-wot/accounts": "^0.1.0",
    "@nostr-wot/storage": "^0.1.0",
    "@scure/base": "^2.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "sideEffects": false
}
