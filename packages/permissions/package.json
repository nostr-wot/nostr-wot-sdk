{
  "name": "@nostr-wot/permissions",
  "version": "0.1.0",
  "description": "Platform-neutral signing permissions for the @nostr-wot packages: the deny-wins cascade that decides whether a caller may sign, encrypt or decrypt, over an injected storage port.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "MIT",
  "keywords": [
    "nostr",
    "permissions",
    "signer",
    "nip-07",
    "platform-neutral"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/permissions"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/permissions",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@nostr-wot/storage": "^0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "sideEffects": false
}
