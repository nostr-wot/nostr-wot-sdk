{
  "name": "@nostr-wot/wot",
  "version": "3.0.1",
  "description": "Web-of-Trust distance queries for Nostr over an Oracle/relays. WoT class + React hooks.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "GPL-3.0-only",
  "keywords": [
    "nostr",
    "web-of-trust",
    "wot",
    "social-graph",
    "trust",
    "decentralized",
    "react-hooks",
    "extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git",
    "directory": "packages/wot"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk/tree/main/packages/wot",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./graph": {
      "import": {
        "types": "./dist/graph/index.d.ts",
        "default": "./dist/graph/index.js"
      },
      "require": {
        "types": "./dist/graph/index.d.cts",
        "default": "./dist/graph/index.cjs"
      }
    },
    "./graph/react": {
      "import": {
        "types": "./dist/graph/react/index.d.ts",
        "default": "./dist/graph/react/index.js"
      },
      "require": {
        "types": "./dist/graph/react/index.d.cts",
        "default": "./dist/graph/react/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/dist-stamp.mjs stamp",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:dist": "node ../../scripts/dist-stamp.mjs check"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "nostr-tools": ">=2.0.0",
    "nostr-wot-sdk": "^3.0.1-next.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "nostr-wot-sdk": {
      "optional": true
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "vitest": "^4.0.18",
    "fake-indexeddb": "^6.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {}
}
