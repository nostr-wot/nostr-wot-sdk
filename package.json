{
  "name": "nostr-wot-sdk-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for the @nostr-wot/* packages.",
  "author": "Leon Acosta <leon@nostr-wot.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostr-wot/nostr-wot-sdk.git"
  },
  "homepage": "https://github.com/nostr-wot/nostr-wot-sdk#readme",
  "type": "module",
  "workspaces": [
    "packages/data",
    "packages/relay",
    "packages/signers",
    "packages/blossom",
    "packages/dm",
    "packages/wallet",
    "packages/wot",
    "packages/ui",
    "packages/auth",
    "packages/sdk"
  ],
  "scripts": {
    "build": "npm run build -w @nostr-wot/data && npm run build -w @nostr-wot/relay && npm run build -w @nostr-wot/signers && npm run build -w @nostr-wot/blossom && npm run build -w @nostr-wot/dm && npm run build -w @nostr-wot/wallet && npm run build -w @nostr-wot/wot && npm run build -w @nostr-wot/ui && npm run build -w @nostr-wot/auth && npm run build -w nostr-wot-sdk",
    "dev": "npm run dev -ws --if-present",
    "test": "npm run test -ws --if-present",
    "test:run": "npm run test:run -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "clean": "rm -rf packages/*/dist",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.31.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.7",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^9.39.2",
    "nostr-tools": "^2.23.3",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "solid-js": "^1.9.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
